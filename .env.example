# Copiar a .env (ignorado por git) y completar. Lo usa docker-compose.yml.
# DB_CONNECTION_STRING y GCP_PROJECT_ID los fuerza docker-compose (base local, secretos desde este archivo).

CLIENT_NAME=meso
FUDO_AUTH_ENDPOINT=https://auth.fu.do/api
FUDO_API_BASE_URL=https://api.fu.do

# Credenciales de Fudo por sucursal (mismos nombres que en clients/<cliente>/branches.sql).
# Opcional si sembrás el token de prod en etl_fudo_tokens (ver LOCAL_TESTING.md):
# sin estas variables el ETL nunca pide un token nuevo y no hay riesgo de pisar el de prod.
# FUDO_MESO_UNIDAD_APIKEY=
# FUDO_MESO_UNIDAD_APISECRET=

# Opcionales del ETL
# ETL_BRANCH_WORKERS=3
# ETL_ENTITY_WORKERS=2
# DB_POOL_SIZE=7
# DB_POOL_PING_AFTER_IDLE_SECONDS=60
# API_ENTITY_DEADLINE_SECONDS=1800
# API_INTER_PAGE_DELAY_SECONDS=0.15
# FUDO_MAX_RETRY_AFTER_SECONDS=300
# FUDO_TOKEN_MIN_VALIDITY_MINUTES=60
# DB_LOCK_TIMEOUT_MS=30000
# REBUILD_MVS=false

# Recursos del contenedor (igual que Cloud Run). Meso: 4g / 2
# ETL_MEM_LIMIT=2g
# ETL_CPUS=1
